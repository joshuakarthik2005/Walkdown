# Copy to .env and fill in real values. Never commit .env.
MODEL_API_KEY=your-meta-model-api-key-here
BASETEN_API_KEY=your-baseten-api-key-here
ROBOFLOW_API_KEY=your-roboflow-api-key-here
FIREWORKS_API_KEY=your-fireworks-api-key-here
# Hugging Face token for the gated SAM 3.1 / FLUX / Glimmer weights used by the Modal apps
HF_TOKEN=your-hugging-face-token-here
# Where datasets are stored, outside the repo (not a secret)
WALKDOWN_DATA_DIR=G:/walkdown-data
# --- Public demo mode (backend/api/demo.py); none of these are secrets ---
# DEMO_MODE=true
# DEMO_DAILY_CAP_USD=5            # global daily spend cap across all providers
# DEMO_MAX_UPLOAD_MB=50
# DEMO_MAX_DURATION_S=60
# DEMO_LIMIT_RUN_PER_HOUR=6       # also UPLOAD, VOICE, ASK, CHANGE, EXAMPLE
# CORS_ORIGINS=https://your-frontend.example   # comma-separated; localhost is always allowed
# PUBLIC_API_URL=https://your-api.example
